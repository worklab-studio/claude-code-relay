{
  "name": "@relay/hooks",
  "version": "0.0.0",
  "private": true,
  "description": "Relay hook script: bundled by esbuild into packages/plugin/dist/hook.mjs (DESIGN.md §2.2, §4). Zero runtime dependencies; Node >= 18 built-ins only.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=../plugin/dist/hook.mjs --legal-comments=none --log-level=warning",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@relay/core": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
